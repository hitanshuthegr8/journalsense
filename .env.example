# Copy to .env and fill in real values. .env is gitignored and must never be committed.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# OpenAlex
# ---------------------------------------------------------------------------
# OpenAlex asks callers to identify themselves with an email. Doing so puts your
# requests in the "polite pool", which gets faster and more consistent rate limits.
# This is not a secret, but it is a real address, so it is configured rather than
# hardcoded. Anonymous requests still work - they are just rate-limited harder.
#
# Docs: https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_MAILTO=you@example.com

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to browser code. Anything you put
# here is PUBLIC - it ships in the JS bundle. Never put a secret behind a VITE_ name.
#
# Base URL of the recommendation API. Not yet consumed: the React app currently makes
# no network calls. Wiring it up is a later phase.
VITE_API_BASE_URL=http://localhost:8000
